{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/frontend/browser",
  "rewrites": [
    {
      "source": "/api/:caminho*",
      "destination": "https://mais-sustentavel.onrender.com/api/:caminho*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
