# Copie para infra/.env e ajuste. NUNCA comite segredos reais (Art. 7.4).

# --- Desenvolvimento local (docker-compose) ---
DB_PASSWORD=mais_sustentavel

# Gestor inicial semeado no dev (o docker-compose tem defaults; sobrescreva aqui se quiser).
SEED_GESTOR_EMAIL=gestor@maissustentavel.local
SEED_GESTOR_SENHA=Gestor@123

# CA-02: base da URL embutida no QR dos pontos. Em produção aponte para o
# domínio do frontend (Vercel), ex.: https://mais-sustentavel.vercel.app
APP_PONTO_BASE_URL=http://localhost:4200

# --- Referência para homologação/produção (banco = Supabase) ---
# Preencha estes no painel da Render (API) — não neste arquivo:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<PROJETO>.supabase.co:5432/postgres?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<senha-do-supabase>